{
  "version": 3,
  "configurePresets": [
    {
      "name": "release", "displayName": "Windows x64 Release",
      "description": "Uses the newest Visual Studio installed.",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {"BUILD_TESTING": "ON"}
    }
  ],
  "buildPresets": [{"name": "release", "configurePreset": "release", "configuration": "Release"}],
  "testPresets": [{"name": "release", "configurePreset": "release", "configuration": "Release", "output": {"outputOnFailure": true}}]
}
