      VALUE "ProductName", "Glimpse\0"
      VALUE "ProductVersion", "0.2.0\0"
      VALUE "OriginalFilename", "Glimpse.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
